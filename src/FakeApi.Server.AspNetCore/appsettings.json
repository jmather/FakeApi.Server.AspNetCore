{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "FakeApi.Server.AspNetCore.Logging.RequestLog": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "FakeApi": {
    "LogCapture": "none",
    "LogXmlPath": ""
  },
  "AllowedHosts": "*"
}
